@@ -0,0 +1,124 @@
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import { PaneTab, PaneTabLabel, PaneTabStrip } from './pane-tab'
+
+afterEach(cleanup)
+
+/** Three zone tabs in a strip, the first active — the shape the shell renders
+ *  for a stacked pane group (WORKFLOWS | …). */
+function renderTabs(onActivate: (id: string) => void = () => {}) {
+  return render(
+    <PaneTabStrip>
+      <PaneTab active aria-selected onActivate={() => onActivate('a')} role="tab">
+        <PaneTabLabel>Alpha</PaneTabLabel>
+      </PaneTab>
+      <PaneTab aria-selected={false} onActivate={() => onActivate('b')} role="tab">
+        <PaneTabLabel>Beta</PaneTabLabel>
+      </PaneTab>
+      <PaneTab aria-selected={false} onActivate={() => onActivate('c')} role="tab">
+        <PaneTabLabel>Gamma</PaneTabLabel>
+      </PaneTab>
+    </PaneTabStrip>
+  )
+}
+
+describe('PaneTab keyboard navigation (ARIA tabs pattern)', () => {
+  it('exposes a tablist of tabs with a roving tabindex (only the selected tab is tabbable)', () => {
+    renderTabs()
+
+    expect(screen.getByRole('tablist')).toBeTruthy()
+
+    const tabs = screen.getAllByRole('tab')
+    expect(tabs).toHaveLength(3)
+    expect(tabs[0].getAttribute('aria-selected')).toBe('true')
+
+    // Roving tabindex: exactly the selected tab sits in the page tab order.
+    expect(tabs[0].tabIndex).toBe(0)
+    expect(tabs[1].tabIndex).toBe(-1)
+    expect(tabs[2].tabIndex).toBe(-1)
+  })
+
+  it('ArrowRight moves focus to the next tab and wraps at the end', () => {
+    renderTabs()
+
+    const tabs = screen.getAllByRole('tab')
+    tabs[0].focus()
+    expect(globalThis.document.activeElement).toBe(tabs[0])
+
+    fireEvent.keyDown(tabs[0], { key: 'ArrowRight' })
+    expect(globalThis.document.activeElement).toBe(tabs[1])
+
+    fireEvent.keyDown(tabs[1], { key: 'ArrowRight' })
+    expect(globalThis.document.activeElement).toBe(tabs[2])
+
+    fireEvent.keyDown(tabs[2], { key: 'ArrowRight' })
+    expect(globalThis.document.activeElement).toBe(tabs[0])
+  })
+
+  it('ArrowLeft moves focus to the previous tab and wraps at the start', () => {
+    renderTabs()
+
+    const tabs = screen.getAllByRole('tab')
+    tabs[0].focus()
+
+    fireEvent.keyDown(tabs[0], { key: 'ArrowLeft' })
+    expect(globalThis.document.activeElement).toBe(tabs[2])
+
+    fireEvent.keyDown(tabs[2], { key: 'ArrowLeft' })
+    expect(globalThis.document.activeElement).toBe(tabs[1])
+  })
+
+  it('Home and End jump focus to the first and last tab', () => {
+    renderTabs()
+
+    const tabs = screen.getAllByRole('tab')
+    tabs[1].focus()
+
+    fireEvent.keyDown(tabs[1], { key: 'End' })
+    expect(globalThis.document.activeElement).toBe(tabs[2])
+
+    fireEvent.keyDown(tabs[2], { key: 'Home' })
+    expect(globalThis.document.activeElement).toBe(tabs[0])
+  })
+
+  it('Enter activates the focused tab, not the currently active one', () => {
+    const onActivate = vi.fn()
+    renderTabs(onActivate)
+
+    const tabs = screen.getAllByRole('tab')
+    tabs[1].focus()
+    fireEvent.keyDown(tabs[1], { key: 'Enter' })
+
+    expect(onActivate).toHaveBeenCalledTimes(1)
+    expect(onActivate).toHaveBeenCalledWith('b')
+  })
+
+  it('Space activates the focused tab', () => {
+    const onActivate = vi.fn()
+    renderTabs(onActivate)
+
+    const tabs = screen.getAllByRole('tab')
+    tabs[2].focus()
+    fireEvent.keyDown(tabs[2], { key: ' ' })
+
+    expect(onActivate).toHaveBeenCalledWith('c')
+  })
+
+  it('leaves a non-tab PaneTab (a page header) unfocusable and inert to tab keys', () => {
+    const onActivate = vi.fn()
+    render(
+      <PaneTab onActivate={onActivate}>
+        <PaneTabLabel>Header</PaneTabLabel>
+      </PaneTab>
+    )
+
+    const header = screen.getByText('Header').closest('[data-slot="pane-tab"]') as HTMLElement
+    expect(header.getAttribute('role')).toBeNull()
+    expect(header.tabIndex).toBe(-1)
+
+    fireEvent.keyDown(header, { key: 'ArrowRight' })
+    fireEvent.keyDown(header, { key: 'Enter' })
+    expect(onActivate).not.toHaveBeenCalled()
+  })
+})
