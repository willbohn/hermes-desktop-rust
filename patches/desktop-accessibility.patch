+import { describe, expect, it } from 'vitest'
+
+import { wrapText } from './text'
+
+/**
+ * Deterministic stand-in for `CanvasRenderingContext2D`: every code point is
+ * `charW` wide, so a line's measured width is `codePoints × charW`. This keeps
+ * the wrap decision a pure function of the text, without a real canvas.
+ */
+function ctx(charW = 10): CanvasRenderingContext2D {
+  return { measureText: (s: string) => ({ width: [...s].length * charW }) } as unknown as CanvasRenderingContext2D
+}
+
+/** Width of the widest line, in the fake canvas's units. */
+function widest(lines: string[], charW = 10): number {
+  return Math.max(0, ...lines.map(line => [...line].length * charW))
+}
+
+describe('wrapText', () => {
+  it('keeps ordinary whitespace word wrapping', () => {
+    const lines = wrapText(ctx(10), 'alpha beta gamma delta', 60)
+
+    expect(lines).toEqual(['alpha', 'beta', 'gamma', 'delta'])
+    expect(lines.join(' ')).toBe('alpha beta gamma delta')
+    expect(widest(lines)).toBeLessThanOrEqual(60)
+  })
+
+  it('wraps a continuous CJK label within the width budget without losing text', () => {
+    // The Memory Graph tooltip's repro shape: one long unspaced CJK run, 11px
+    // glyphs, a 368px title box (#146215).
+    const label = '中文标签应当在画布提示范围内完整可读'.repeat(20)
+    const lines = wrapText(ctx(11), label, 368)
+
+    expect(lines.length).toBeGreaterThan(1)
+    expect(widest(lines, 11)).toBeLessThanOrEqual(368)
+    // No whitespace to lose: concatenating the lines must reproduce the input.
+    expect(lines.join('')).toBe(label)
+  })
+
+  it('breaks at grapheme boundaries and never splits a grapheme cluster', () => {
+    // A family emoji is ONE grapheme (7 code points / 4 people + 3 ZWJ) but is
+    // wider than the budget on its own — each stays whole on its own line.
+    const family = '👨\u200d👩\u200d👧\u200d👦'
+    const label = family.repeat(10)
+    const lines = wrapText(ctx(10), label, 20)
+
+    expect(lines).toEqual(Array.from({ length: 10 }, () => family))
+    expect(lines.join('')).toBe(label)
+  })
+
+  it('preserves whitespace wrapping for mixed Latin + CJK content', () => {
+    const lines = wrapText(ctx(10), 'hello 中文标签', 60)
+
+    expect(lines.join(' ')).toBe('hello 中文标签')
+    expect(widest(lines)).toBeLessThanOrEqual(60)
+  })
+
+  it('returns no lines for empty or whitespace-only input', () => {
+    expect(wrapText(ctx(), '', 100)).toEqual([])
+    expect(wrapText(ctx(), '   ', 100)).toEqual([])
+  })
+})
